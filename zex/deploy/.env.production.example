# ZEX-CRM production environment example (no real secrets).
# Copy to a private .env.production (never commit) and fill values.
# Staging and production MUST use different ENCRYPTION_KEY / APP_SECRET /
# ZEX_PLATFORM_ADMIN_API_KEY values.

# ---------------------------------------------------------------------------
# Immutable ZEX CRM image (required). No "latest". Prefer full git SHA tag.
# Registry host is operator-chosen; do not invent one.
# Examples:
#   ZEX_CRM_IMAGE=zex-crm:c831e89e939b378e901014f59674dccea53e9d97
#   ZEX_CRM_IMAGE=ghcr.io/<org>/zex-crm:c831e89e939b378e901014f59674dccea53e9d97
# ---------------------------------------------------------------------------
ZEX_CRM_IMAGE=

# Twenty requires semver. Prefer 0.0.0+<full-git-sha> to mirror the image tag.
APP_VERSION=0.0.0+<full-git-sha>

SERVER_URL=https://crm.example.com
SERVER_PUBLISH_PORT=3000

# Postgres (compose db service defaults shown; managed Postgres also supported)
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=replace_me_strong_password_no_special_chars
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default
# Or set a full URL instead of composing from parts in custom overlays:
# PG_DATABASE_URL=postgres://user:pass@host:5432/default

REDIS_URL=redis://redis:6379

# Twenty crypto secrets — generate separately per environment:
#   openssl rand -base64 32
ENCRYPTION_KEY=
# FALLBACK_ENCRYPTION_KEY=  # previous ENCRYPTION_KEY during rotation only
APP_SECRET=

# Storage: local volume (server-local-data) or S3-compatible object storage
STORAGE_TYPE=local
# STORAGE_TYPE=s3
# STORAGE_S3_REGION=
# STORAGE_S3_NAME=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# ZEX Platform bridge (twenty-server / worker only — never Vite/browser)
# CRM server must reach Platform over a private or authenticated server route.
# Do NOT set ZEX_PLATFORM_TENANT_ID (workspace→tenant lookup is authoritative).
# ---------------------------------------------------------------------------
ZEX_PLATFORM_BASE_URL=https://platform.example.com
ZEX_PLATFORM_ADMIN_API_KEY=replace_me_server_only_platform_admin_key

# Optional auth / email (enable as needed)
# AUTH_GOOGLE_ENABLED=true
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_CALLBACK_URL=
# AUTH_MICROSOFT_ENABLED=true
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_CALLBACK_URL=
# EMAIL_DRIVER=smtp
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=

# Leave empty so server entrypoint runs migrations once.
# DISABLE_DB_MIGRATIONS=
# DISABLE_CRON_JOBS_REGISTRATION=
